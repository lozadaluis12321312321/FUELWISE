{
  "name": "fuelwise-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "icons": "node generate-icons.mjs",
    "dev": "node serve.mjs",
    "test": "npm run build && playwright test",
    "mobile:sync": "npm run build && cap sync",
    "capacitor:sync:after": "node native-sync.mjs",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.4.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
