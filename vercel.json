{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/fuel-tracker/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/fuel-tracker/:path*",
      "destination": "/fuel-tracker/:path*"
    },
    {
      "source": "/fuel-tracker",
      "destination": "/fuel-tracker/index.html"
    },
    {
      "source": "/fuel-tracker/",
      "destination": "/fuel-tracker/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/fuel-tracker/:path*"
    },
    {
      "source": "/app",
      "destination": "/fuel-tracker/index.html"
    },
    {
      "source": "/app/",
      "destination": "/fuel-tracker/index.html"
    },
    {
      "source": "/fuelwise-site/:path*",
      "destination": "/fuelwise-site/:path*"
    },
    {
      "source": "/fuelwise-site",
      "destination": "/fuelwise-site/index.html"
    },
    {
      "source": "/fuelwise-site/",
      "destination": "/fuelwise-site/index.html"
    },
    {
      "source": "/",
      "destination": "/fuelwise-site/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/fuelwise-site/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/fuelwise-site/:path*"
    }
  ]
}
